# Copiá este archivo a .env.local y completá los valores reales.
# .env.local nunca se sube al repo (está en .gitignore).

# --- LLM ---
# Proveedor: gemini | groq | ollama (todos hablan formato OpenAI-compatible)
LLM_PROVEEDOR=gemini
LLM_API_KEY=
# Opcional: solo si querés pisar la URL por defecto del proveedor elegido
# LLM_BASE_URL=
# Opcional: solo si querés pisar el modelo por defecto del proveedor elegido
# LLM_MODELO=gemini-2.5-flash

# --- Base de datos ---
DB_PATH=./data/campania.db

# --- Voz (TTS con Piper) ---
PIPER_BIN=./tools/piper/piper.exe
PIPER_VOCES_DIR=./tools/piper/voces
VOZ_NARRADOR=es_AR-daniela-high
VOCES_NPC=es_ES-davefx-medium,es_MX-claude-high

# --- Voz (STT con whisper.cpp) ---
WHISPER_BIN=./tools/whisper/Release/whisper-cli.exe
WHISPER_MODELO=./tools/whisper/modelos/ggml-small.bin
